{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_record.schema.json",
  "title": "EvidenceRecord",
  "type": "object",
  "required": ["evidence_id", "source", "captured_at", "effective_at", "modality", "content"],
  "properties": {
    "evidence_id": {"type": "string"},
    "source": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "effective_at": {"type": "string", "format": "date-time"},
    "modality": {"enum": ["TEXT", "STRUCTURED", "PDF", "FILING", "CHART", "SCREENSHOT", "AUDIO_TRANSCRIPT", "GENERATED_VISUAL"]},
    "content": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "candidate_ids": {"type": "array", "items": {"type": "string"}},
    "contradictions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
